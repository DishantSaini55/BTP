        <mxCell id="encoder" value="MTN Encoder ×3&lt;br&gt;three sequential layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#2F80ED;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="trajectory"><mxGeometry x="505" y="70" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="memory" value="Trajectory memory&lt;br&gt;[B,15,32]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#2F80ED;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="trajectory"><mxGeometry x="745" y="75" width="185" height="58" as="geometry"/></mxCell>
